! X colors.
! Generated by 'wal'
*foreground:        #9ca19e
*background:        #010402
*.foreground:       #9ca19e
*.background:       #010402
emacs*foreground:   #9ca19e
emacs*background:   #010402
URxvt*foreground:   #9ca19e
XTerm*foreground:   #9ca19e
UXTerm*foreground:  #9ca19e
URxvt*background:   [100]#010402
XTerm*background:   #010402
UXTerm*background:  #010402
URxvt*cursorColor:  #9ca19e
XTerm*cursorColor:  #9ca19e
UXTerm*cursorColor: #9ca19e
URxvt*borderColor:  [100]#010402

! Colors 0-15.
*.color0: #010402
*color0:  #010402
*.color1: #214944
*color1:  #214944
*.color2: #593c35
*color2:  #593c35
*.color3: #366d42
*color3:  #366d42
*.color4: #7f8c7c
*color4:  #7f8c7c
*.color5: #67a35c
*color5:  #67a35c
*.color6: #84a484
*color6:  #84a484
*.color7: #9ca19e
*color7:  #9ca19e
*.color8: #3a443e
*color8:  #3a443e
*.color9: #214944
*color9:  #214944
*.color10: #593c35
*color10:  #593c35
*.color11: #366d42
*color11:  #366d42
*.color12: #7f8c7c
*color12:  #7f8c7c
*.color13: #67a35c
*color13:  #67a35c
*.color14: #84a484
*color14:  #84a484
*.color15: #9ca19e
*color15:  #9ca19e

! Black color that will not be affected by bold highlighting.
*.color66: #010402
*color66:  #010402

! Xclock colors.
XClock*foreground: #9ca19e
XClock*background: #010402
XClock*majorColor:  rgba:9c/a1/9e/ff
XClock*minorColor:  rgba:9c/a1/9e/ff
XClock*hourColor:   rgba:9c/a1/9e/ff
XClock*minuteColor: rgba:9c/a1/9e/ff
XClock*secondColor: rgba:9c/a1/9e/ff

! Set depth to make transparency work.
URxvt*depth: 32
