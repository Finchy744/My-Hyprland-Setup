@import "~/.config/rofi/colors.rasi"
@import "~/.config/rofi/image.rasi"

/*****----- Configuration -----*****/
configuration {
    modi:                       "drun,run,filebrowser";
    show-icons:                 true;
    display-drun:               "󰘔";
    display-run:                "󰅍";
    display-filebrowser:        "󰝰";
    drun-display-format:        "{name}";
}

/*****----- Global Properties -----*****/
* {
    font:                       "JetBrainsMono Nerd Font 10";
}

/*****----- Main Window -----*****/
window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    width:                      850px;
    x-offset:                   0px;
    y-offset:                   0px;

    enabled:                    true;
    margin:                     0px;
    padding:                    0px;
    border:                     2px solid;
    border-color:               @foreground;
    border-radius:              30px 5px 30px 5px;
    background-color:           @background;
    cursor:                     "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                    true;
    spacing:                    0px;
    background-color:           transparent;
    orientation:                vertical;
    children:                   [ "inputbar", "listview" ];
}

/*****----- Inputbar / Header Banner -----*****/
inputbar {
    enabled:                    true;
    spacing:                    10px;
    /* Pushes search bar & buttons toward the bottom of the image banner */
    padding:                    150px 24px 24px 24px; 
    border-radius:              18px 18px 0px 0px;
    background-color:           transparent;
    background-image:           var(current-image, url("", width));
    text-color:                 @foreground;
    orientation:                horizontal;
    children:                   [ "textbox-prompt-colon", "entry", "dummy", "mode-switcher" ];
}

textbox-prompt-colon {
    enabled:                    true;
    expand:                     false;
    str:                        "";
    padding:                    10px 14px;
    border-radius:              10px;
    background-color:           #00000066;
    text-color:                 inherit;
    vertical-align:             0.5;
}

entry {
    enabled:                    true;
    expand:                     false;
    width:                      220px;
    padding:                    10px 14px;
    border-radius:              10px;
    background-color:           #00000066;
    text-color:                 inherit;
    cursor:                     text;
    placeholder:                "Search";
    placeholder-color:          inherit;
    vertical-align:             0.5;
}

dummy {
    expand:                     true;
    background-color:           transparent;
}

/*****----- Mode Switcher -----*****/
mode-switcher {
    enabled:                    true;
    spacing:                    8px;
    background-color:           transparent;
    text-color:                 @foreground;
}

button {
    width:                      40px;
    height:                     40px;
    padding:                    8px;
    border-radius:              10px;
    background-color:           #00000066;
    text-color:                 inherit;
    cursor:                     pointer;
    vertical-align:             0.5;
    horizontal-align:           0.5;
}

button selected {
    background-color:           @selected-normal-background;
    text-color:                 @foreground;
}

/*****----- Listview -----*****/
listview {
    enabled:                    true;
    columns:                    2;
    lines:                      6;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               true;
    fixed-columns:              true;
    spacing:                    10px;
    margin:                     0px;
    padding:                    20px;

    /* Divider line separating the image banner from the application list */
    border:                     2px 0px 0px 0px;
    border-color:               @foreground;
    background-color:           transparent;
    text-color:                 @foreground;
    cursor:                     "default";
}

/*****----- Elements -----*****/
element {
    enabled:                    true;
    spacing:                    12px;
    padding:                    10px 14px;
    border-radius:              12px;
    background-color:           transparent;
    text-color:                 @foreground;
    cursor:                     pointer;
}

element selected.normal {
    background-color:           @selected-normal-background;
    text-color:                 @foreground;
}

element-icon {
    background-color:           transparent;
    text-color:                 inherit;
    size:                       28px;
    cursor:                     inherit;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    highlight:                  inherit;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0.0;
}

